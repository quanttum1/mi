            <ul>
                %(any(
                    tok("<li>mi pana e wile pana<a href=\"https://github.com/pona-la/ma.pona.la/pull/1\">ni</a>tawa lipu te <a href=\"https://ma.pona.la/\">ma.pona.la</a> to  taso mi sona ala e ni: ona li pona ala pona</li>"),
