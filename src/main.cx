        <script>
        function smallerThan5(n) {
          if (n >= 5) throw new Error("n must be < 5");
          let result = [];

          while (n > 1) {
            result.push('%(ucsur("tu"))%');
            n -= 2;
          }

          if (n === 1) {
            result.push('%(ucsur("wan"))%');
          }

          return result;
        }

        function smallerThan20(n) {
          if (n >= 20) throw new Error("n must be < 20");
          let result = [];

          let beforeLuka = Math.floor(n / 5);
          if (beforeLuka > 1) {
            result = result.concat(smallerThan5(beforeLuka));
          }
          if (beforeLuka) {
            result.push('%(ucsur("luka"))%');
          }

          result = result.concat(smallerThan5(n % 5));
          return result;
        }

        function toNnppl(n) {
          let result = [];

          if (n >= 100) {
            result.push(toNnppl(Math.floor(n / 100)));
            result.push('%("ale")%');
          }

          n %= 100;

          let beforeMute = Math.floor(n / 20);
          if (beforeMute > 1) {
            result = result.concat(smallerThan5(beforeMute));
          }
          if (beforeMute) {
            result.push('%(ucsur("mute"))%');
          }

          result = result.concat(smallerThan20(n % 20));

          if (result.length === 0) result = ['%(ucsur("ala"))%'];
          return result.join('');
        }

        let birthday = new Date("2007-08-29");
        let now = new Date();
        let age = Math.floor((now - birthday) / (365.25 * 24 * 60 * 60 * 1000));

        // addEventListener("load", () => {
            %(any(
                tok("ageSpan.innerText = toNnppl(age);"),
                en("ageSpan.innerText = age;"),
                ru("ageSpan.innerText = age;")
            ))%
        // });

        </script>
    </>;
}

HTML nanpa_wan() {
    return <>
        <script>
            location.pathname = "/tok" + location.pathname;
        </script>
    </>;
}

typedef struct {
    char *path;
    HTML content;
} Page;

typedef da(Page) PageList;

PageList global_page_list = {0};
char *current_path;

void begin_page_list() {
    current_path = strdup("/");
}

void add_index(HTML content) {
    if (current_layout != NULL) {
        content = current_layout(content);
    }

    char *page_path = strdup("");
    str_appendf(&page_path, "%sindex.html", current_path);
    da_append(global_page_list, ((Page){ .path = page_path, .content = content }));
}

void begin_children(char *path) {
    str_appendf(&current_path, "%s/", path);
}

char *get_parent(char* with_child) {
    with_child = strdup(with_child); // 'Cause it's up to the caller to free it
    assert(strlen(with_child) > 1 && "No root");

    int new_len = -1;
    for (int i = strlen(with_child) - 2; i >= 0; i--) {
        if (with_child[i] == '/') {
            new_len = i + 1;
            break;
        }
    }

    if (new_len == -1) assert(!"No '/' found in the path");

    with_child = realloc(with_child, new_len + 1);
    with_child[new_len] = '\0';

    return with_child;
}

void end_children() {
    char *last_path = current_path;
    current_path = get_parent(current_path);
    free(last_path);
}

void add_child(char *path, HTML content) {
    begin_children(path); {
        add_index(content);
    } end_children();
}

PageList end_page_list() {
    assert(strcmp(current_path, "/") == 0);
    free(current_path);
    PageList result = global_page_list;
    global_page_list = (PageList){0};
    return result;
}

// TODO(2026-09-09 13:50:13): maybe let it accept directory to export to
void export(PageList page_list) {
    system("rm -r docs/*");

    for (size_t i = 0; i < da_size(page_list); i++) {
        char *command = strdup("mkdir -p docs");
        char *parent = get_parent(page_list[i].path);
        str_appendf(&command, parent);
        free(parent);
        system(command);
        free(command);

        char *file_path = strdup("docs");
        str_appendf(&file_path, page_list[i].path);
        FILE *fp = fopen(file_path, "w");
        fprintf(fp, "%s", page_list[i].content);
        fclose(fp);
        free(file_path);
    }

    system("cp -r public/* docs");
}

void begin_layout(Layout layout) {
    assert(current_layout == NULL);
    current_layout = layout;
}

void end_layout() {
    assert(current_layout != NULL);
}

