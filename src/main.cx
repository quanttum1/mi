            %(any(
                tok("<span>tenpo suno nanpa 11:</span>"),
                en("<span>11-th:</span>"),
                ru("<span>tenpo suno nanpa 11:</span>")
            ))%
            <ul>
                %(any(
                    tok("<li>mi pana e wile pana<a href=\"https://github.com/netfri25/sitelen-ucsur/pull/2\">ni</a>tawa ilo pi sitelen Jusisu</li>"),
