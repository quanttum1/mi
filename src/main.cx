#include <stdbool.h>
#include <stdio.h>
#include <stdlib.h>
#include <assert.h>
#include "da.h"
#include "./str_appendf.c"

typedef HTML (*Layout)(HTML);

char *current_language = {0};
Layout current_layout = NULL;

HTML tok(HTML translation) {
    if (strcmp(current_language, "tok") == 0) return strdup(translation);
    else return NULL;
}

HTML en(HTML translation) {
    if (strcmp(current_language, "en") == 0) return strdup(translation);
    else return NULL;
}

HTML ru(HTML translation) {
    if (strcmp(current_language, "ru") == 0) return strdup(translation);
    else return NULL;
}

HTML any(HTML tok, HTML en, HTML ru) {
    char *result = NULL;

    result = tok ? tok : result;
    result = en ? en : result;
    result = ru ? ru : result;

    if (!result) {
        printf("'%s' has no translation");
        assert(0);
    }

    return result;
}

char *ucsur(char *sitelenLasina) {
    char *wile = strdup("echo -n '");
    str_appendf(&wile, "%s", sitelenLasina);
    str_appendf(&wile, "' | sitelen-ucsur from");

    FILE *fp = popen(wile, "r");
    free(wile);

    char *sitelenUcsur = strdup("");

    int sitelen = 0;
    while (1) {
        sitelen = getc(fp);
        if (sitelen == EOF) break;
        str_appendf(&sitelenUcsur, "%c", sitelen);
    }

    pclose(fp);
    return sitelenUcsur;
}


