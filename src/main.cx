                    ru("<li>mi pana e wile pana<a href=\"https://github.com/pona-la/ma.pona.la/pull/1\">ni</a>tawa lipu te <a href=\"https://ma.pona.la/\">ma.pona.la</a> to  taso mi sona ala e ni: ona li pona ala pona</li>")
                ))%
            </ul>
            <br>

            %(any(
                tok("<span>tenpo suno nanpa 8:</span>"),
                en("<span>8-th:</span>"),
                ru("<span>tenpo suno nanpa 8:</span>")
            ))%
            <ul>
                %(any(
                    tok("<li>mi kama jo e wile pana<a href=\"https://github.com/quanttum1/meowfiles/pull/2\">ni</a>  mi pana e ona tawa poki mi</li>"),
                    en("<li>i accepted <a href=\"https://github.com/quanttum1/meowfiles/pull/2\">this PR </a>to my repository</li>"),
                    ru("<li>mi kama jo e wile pana<a href=\"https://github.com/quanttum1/meowfiles/pull/2\">ni</a>  mi pana e ona tawa poki mi</li>")
                ))%
            </ul>
            <br>

            %(any(
                tok("<span>tenpo suno nanpa 6:</span>"),
                en("<span>6-th:</span>"),
                ru("<span>tenpo suno nanpa 6:</span>")
            ))%
            <ul>
                %(any(
                    tok("<li>mi lon e lipu mi pi jan wan tawa https://jan-luna-wani.li.pona.la/</li>"),
                    en("<li>i hosted my personal website on https://jan-luna-wani.li.pona.la/</li>"),
                    ru("<li>mi lon e lipu mi pi jan wan tawa https://jan-luna-wani.li.pona.la/</li>")
                ))%
            </ul>
            <br>

            %(any(
                tok("<span>tenpo suno nanpa 4:</span>"),
                en("<span>4-th:</span>"),
                ru("<span>tenpo suno nanpa 4:</span>")
            ))%
            <ul>
                %(any(
